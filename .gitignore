# Local environments / models (never commit multi-GB checkpoints or private voices)
.venv/
.venv-voice-*/
.env
.env.*
!.env.example
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Browser / package installations
node_modules/
.puppeteer-cache/
# HyperFrames local editor state (not a composition asset)
**/.hyperframes/

# Media builds and user-supplied assets
output/
models/
checkpoints/
*.wav
*.mp3
*.flac
*.m4a
*.mp4
*.mov
*.webm
videos/**/private/
!assets/fonts/*.ttf

# Requested deliverable: the finished 4K film (3840x2160, 120 s, H.264/AAC,
# 86 MB) rendered locally by `v-creator animate --final`, with its subtitle
# sidecar and production manifest. Everything else under FF/ stays untracked.
!FF/ghost-hassan-final-4k.mp4
!FF/ghost-hassan-final-4k.srt
!FF/ghost-hassan-final-4k.manifest.json

# Requested deliverable: the generated scene audio set for the FF package
# (13+ MB, produced locally by scripts/narrate-scenes.py and documented in
# FF/audios/README.md). Human recordings and voice samples stay untracked.
!FF/audios/*.wav
!FF/audios/*.mp3
!FF/audios/narration/*.wav
!FF/audios/dialogue/*.wav
FF/audios/private/

# Editors
.DS_Store
*.swp
